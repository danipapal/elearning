# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.

# Supabase > Project Settings > API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública ("publishable key", sb_publishable_...) o la "anon key" antigua. Es segura en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio, sin barra final (en local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcionales (ver docs/configuracion.md, partes 4 y 5) ---
# Emails con Resend. SECRETA: solo en el servidor.
RESEND_API_KEY=
# Remitente en tu dominio verificado en Resend, ej: hola@tudominio.com
EMAIL_FROM=
# Captcha de Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
